{
  "name": "bindery-mcp",
  "version": "1.0.0",
  "description": "MCP server for Bindery markdown book projects — chapter navigation, search, typography formatting, and export.",
  "main": "out/index.js",
  "files": [
    "out"
  ],
  "bin": {
    "bindery-mcp": "./out/index.js"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=verbose --reporter=json --outputFile=test-results.json",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "markdown",
    "book",
    "writing",
    "bindery"
  ],
  "author": "Erik van der Boom",
  "license": "MIT",
  "dependencies": {
    "@bindery/core": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.2",
    "minisearch": "^7.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "hono": ">=4.13.11",
    "vite": ">=8.1.6",
    "@hono/node-server": ">=2.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
