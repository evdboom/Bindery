{
  "name": "bindery-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "bindery-core",
    "bindery-merge",
    "vscode-ext",
    "mcp-ts",
    "obsidian-plugin"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "test": "npm run test -ws --if-present",
    "lint": "npx eslint . --format=stylish",
    "lint:fix": "npx eslint . --fix",
    "build:core": "npm run build --workspace=bindery-core",
    "obsidian:sync-version": "node ./scripts/sync-obsidian-version.mjs",
    "benchmark": "npm run build --workspace=bindery-core && npm run build --workspace=bindery-merge && npm run compile --workspace=mcp-ts && node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "eslint-plugin-obsidianmd": "^0.5.1"
  },
  "overrides": {
    "qs": "^6.16.1",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.11",
    "@microsoft/eslint-plugin-sdl": {
      "eslint-plugin-n": "17.24.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
